# =========================================
# Company AI - Environment Example
# =========================================

# Project
COMPOSE_PROJECT_NAME=company-ai
PROJECT_NAME=Company AI
APP_ENV=development
APP_TIMEZONE=Europe/Sofia
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=company_ai
POSTGRES_USER=company_ai
POSTGRES_PASSWORD=replace_with_generated_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_HOST_PORT=8000

# Agent
AGENT_POLL_INTERVAL_SECONDS=5

# Dashboard
DASHBOARD_HOST_PORT=5173

# Application security
APP_SECRET_KEY=replace_with_generated_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
AGENT_CREDENTIAL_PEPPER=replace_with_generated_agent_credential_pepper
AGENT_JWT_SECRET=replace_with_generated_agent_jwt_secret
AGENT_JWT_ALGORITHM=HS256
AGENT_JWT_TTL_SECONDS=300
AGENT_JWT_ISSUER=company-ai
AGENT_JWT_AUDIENCE=company-ai-agent-runtime
# Non-secret active key ID. Key IDs must match ^[a-z][a-z0-9_-]{0,63}$.
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=local-primary
# Secret compact JSON mapping key IDs to encoded 32-byte AES keys. Never commit or log a populated value.
CREDENTIAL_ENCRYPTION_KEYRING={"local-primary":"replace_with_generated_32_byte_key"}
