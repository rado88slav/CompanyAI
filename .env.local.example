# =========================================
# CompanyAI Local Edition Environment Example
# =========================================
# Copy this file to .env.local and replace every generated placeholder.
# Never commit .env.local or any populated secret values.

COMPOSE_PROJECT_NAME=company-ai-local
APP_ENV=local-production
APP_TIMEZONE=Europe/Sofia
POSTGRES_IMAGE=postgres:18-alpine

# Local URL: http://localhost:8080
# Keep 127.0.0.1 for normal local-only operation.
# LAN access can be enabled later by changing this to 0.0.0.0 intentionally.
LOCAL_APP_BIND_ADDRESS=127.0.0.1
LOCAL_APP_PORT=8080

POSTGRES_DB=company_ai
POSTGRES_USER=company_ai
POSTGRES_PASSWORD=replace_with_generated_database_password

APP_SECRET_KEY=replace_with_generated_application_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Non-secret active key ID. Key IDs must match ^[a-z][a-z0-9_-]{0,63}$.
CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=local-primary
# Secret compact JSON mapping key IDs to encoded 32-byte AES keys.
CREDENTIAL_ENCRYPTION_KEYRING={"local-primary":"replace_with_generated_32_byte_key"}

AGENT_CREDENTIAL_PEPPER=replace_with_generated_agent_credential_pepper
AGENT_JWT_SECRET=replace_with_generated_agent_jwt_secret
AGENT_JWT_ALGORITHM=HS256
AGENT_JWT_TTL_SECONDS=300
AGENT_JWT_ISSUER=company-ai
AGENT_JWT_AUDIENCE=company-ai-agent-runtime

BACKEND_WORKERS=1
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=5
