# =========================================
# Company AI - Git Ignore
# =========================================

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
config/secrets/
storage/secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Node.js and dashboard
node_modules/
dashboard/node_modules/
dashboard/dist/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime files
logs/
*.log
tmp/
temp/
*.tmp

# Persistent generated storage
storage/cache/*
storage/backups/*
storage/uploads/*
storage/exports/*
storage/reports/*

# Keep storage directory placeholders
!storage/cache/.gitkeep
!storage/backups/.gitkeep
!storage/uploads/.gitkeep
!storage/exports/.gitkeep
!storage/reports/.gitkeep

# Local databases
*.db
*.sqlite
*.sqlite3
postgres-data/
database/data/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Local backups
*.bak
*.backup